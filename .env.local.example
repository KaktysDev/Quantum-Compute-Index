# ──────────────────────────────────────────────────────────────────────────────
# QRouter — environment variables
# Copy this file to ".env.local" for local dev, and add the same vars in Vercel.
# ──────────────────────────────────────────────────────────────────────────────

# Supabase ─ Project Settings → API
# These two are safe to expose to the browser (anon key is public by design).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Supabase service-role key — SERVER ONLY, NEVER expose to the browser.
# Used by the cron job and key-decryption logic. (Project Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Local-only console bypass. Never enable this in production.
QROUTER_DEV_AUTH_BYPASS="false"

# Local-only demo tenant. When "true" (and NODE_ENV is not "production"), calls
# with no credentials — or with the literal key "qci_test_local_development" —
# resolve to a SHARED, UNAUTHENTICATED workspace backed by in-memory stores.
# Every caller sees the same circuits, jobs, and results.
# NEVER set this in production. It is ignored when NODE_ENV=production.
QROUTER_DEMO_MODE="false"

# Requests per minute per ORGANIZATION, shared by API keys and console sessions.
# The console polls job lists every 5s (12 requests/min per open tab), so keep
# headroom for the number of tabs a workspace realistically has open.
QROUTER_RATE_LIMIT_PER_MINUTE="600"

# Maximum non-revoked, non-expired API keys one workspace may hold.
QROUTER_MAX_ACTIVE_API_KEYS="25"

# 32+ char secret used to encrypt provider API keys at rest (AES-256-GCM).
# Generate with:  openssl rand -base64 32
KEY_ENCRYPTION_SECRET="generate-a-long-random-string-min-32-chars"

# Shared secret used by Vercel Cron and any external scheduler that invokes the
# internal QRouter job/health pollers.
# Generate with:  openssl rand -base64 32
CRON_SECRET="generate-another-long-random-string"

# Optional. Signs the GitHub OAuth state parameter. Without it, signing falls
# back to a labelled HMAC of KEY_ENCRYPTION_SECRET, which works but couples
# OAuth state to the envelope-encryption secret so the two cannot be rotated
# independently. Verification accepts every fallback, so setting this later is
# a safe, no-downtime change.
# Generate with:  openssl rand -base64 32
# GITHUB_OAUTH_STATE_SECRET=""

# Optional. The Content-Security-Policy ships as report-only because
# src/app/layout.tsx has a nonce-less inline theme script, which forces
# script-src 'unsafe-inline'. Collect violation reports first, then set this to
# promote the policy to the enforcing header.
# CSP_ENFORCE="false"

# Public site URL — used to build OAuth redirect URLs.
# Local: http://localhost:3000   |   Prod: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# GitHub App repository connection. Set the App callback URL to:
# https://your-domain.com/api/integrations/github/callback
GITHUB_APP_ID="123456"
GITHUB_APP_SLUG="your-qrouter-app"
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"
GITHUB_STATE_SECRET="generate-a-long-random-string"
# Enable "Request user authorization (OAuth) during installation" on the App and
# set its client credentials. Production requires these to verify that the user
# completing the callback actually controls the installation being connected.
GITHUB_APP_CLIENT_ID="Iv1...."
GITHUB_APP_CLIENT_SECRET="..."

# Optional local/public-repository fallback when a GitHub App is unavailable.
GITHUB_TOKEN="github_pat_..."

# QRouter billing
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Physical execution. AWS also requires standard AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY environment variables.
BRAKET_OUTPUT_BUCKET="your-amazon-braket-results-bucket"
IBM_QUANTUM_TOKEN="your-ibm-quantum-token"
IBM_QUANTUM_INSTANCE="ibm-q/open/main"
IBM_QUANTUM_BACKEND="ibm_brisbane"

# Optional Vultr-hosted Qiskit Aer/cuQuantum worker. Without this, development
# uses the bundled state-vector engine.
VULTR_SIMULATOR_URL="https://simulator.example.com"
VULTR_SIMULATOR_TOKEN="generate-a-long-worker-token"
# Worker-side values used by services/simulator/deploy/vultr (not by Next.js).
REQUIRE_GPU="true"
WORKERS="2"
MAX_QUEUED_JOBS="100"
MAX_QUBITS="30"
MAX_SHOTS="1000000"

# Optional AI route advisor. Configured Vultr models are tried first so Vultr
# credits are used before OpenRouter. Override the order with a comma-separated
# list such as "openrouter,vultr".
AI_PROVIDER_ORDER="vultr,openrouter"

# Vultr serverless inference (preferred provider).
VULTR_INFERENCE_API_KEY="your-vultr-inference-api-key"
VULTR_INFERENCE_BASE_URL="https://api.vultrinference.com/v1"
VULTR_MAIN_MODEL="nvidia/Nemotron-Cascade-2-30B-A3B"
VULTR_FALLBACK_MODEL="nvidia/Nemotron-3-Nano-Omni-30B-A3B-Reasoning-BF16"
VULTR_TOOL_MODEL="nvidia/Nemotron-Cascade-2-30B-A3B"
VULTR_MAX_TOKENS="1200"
VULTR_TEMPERATURE="0.2"
VULTR_INFERENCE_TIMEOUT="60"

# OpenRouter fallback. OPENROUTER_PROVIDER_ORDER controls which upstream model
# hosts OpenRouter prefers; leave it empty to use OpenRouter's routing policy.
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MAIN_MODEL="openrouter/auto"
OPENROUTER_FALLBACK_MODEL=""
OPENROUTER_MAX_TOKENS="1200"
OPENROUTER_TEMPERATURE="0.2"
OPENROUTER_TIMEOUT="60"
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_APP_NAME="QRouter"
OPENROUTER_PROVIDER_ORDER=""
OPENROUTER_ALLOW_FALLBACKS="true"
OPENROUTER_DATA_COLLECTION="deny"

# Optional S3-compatible artifact storage. When these are set, encrypted QRouter
# artifacts are written to Vultr Object Storage instead of Supabase Storage.
VULTR_OBJECT_STORAGE_ENDPOINT="https://ewr1.vultrobjects.com"
VULTR_OBJECT_STORAGE_REGION="ewr1"
VULTR_OBJECT_STORAGE_BUCKET="your-qrouter-artifacts-bucket"
VULTR_OBJECT_STORAGE_ACCESS_KEY_ID="your-object-storage-access-key"
VULTR_OBJECT_STORAGE_SECRET_ACCESS_KEY="your-object-storage-secret-key"

# Hardware-aware Qiskit compiler. This may point at the same worker as the
# Vultr simulator. Physical QPU execution is rejected when it is missing.
QROUTER_COMPILER_URL="https://compiler.example.com"
QROUTER_COMPILER_TOKEN="generate-a-long-compiler-token"
QROUTER_PROVIDER_TIMEOUT_MS="20000"

# Direct IonQ execution. When absent, IonQ can route through configured Amazon Braket.
IONQ_API_KEY="your-ionq-cloud-api-key"
IONQ_BACKEND="qpu.aria-1"
IONQ_DEBIASING="false"

# Approved partner execution bridges. Photonic backends encode gate-model
# OpenQASM into a dual-rail native program and submit it only when the bridge
# is configured. Quantum Inspire uses QI_API_KEY against api.quantum-inspire.com
# unless QI_EXECUTION_URL points at an approved bridge instead.
QUANDELA_EXECUTION_URL="https://quandela-bridge.example.com"
QUANDELA_API_KEY="your-quandela-bridge-key"
XANADU_EXECUTION_URL="https://xanadu-bridge.example.com"
XANADU_API_KEY="your-xanadu-bridge-key"
QI_API_KEY="your-quantum-inspire-api-token"
QI_EXECUTION_URL="https://quantum-inspire-bridge.example.com"
# QI_API_BASE="https://api.quantum-inspire.com"
# QI_BACKEND="Starmon-5"

# ── Quantum Compute Index (QCI v2) ────────────────────────────────────────────
# The index's PRICE feeds need no credentials at all:
#   • AWS Braket rate card  pricing.us-east-1.amazonaws.com  (no auth)
#   • ECB FX reference      data-api.ecb.europa.eu           (no auth)
#   • Eurostat electricity  ec.europa.eu/eurostat            (no auth)
#   • US Treasury rates     api.fiscaldata.treasury.gov      (no auth)
# The two keys below are OPTIONAL and only sharpen the COST-BASIS companion
# series. Without them those inputs fall back to pinned defaults, which the UI
# labels as assumptions. Neither can affect the published index level.

# US industrial electricity price by state (monthly, ~2-month lag).
# Free, instant: https://www.eia.gov/opendata/register.php
EIA_API_KEY=""

# BLS Producer Price Index for industrial gas manufacturing — the cryogen /
# helium proxy (monthly). No daily helium price feed exists anywhere.
# Free registration: https://data.bls.gov/registrationEngine/
BLS_API_KEY=""

# Gemini API key for the console assistant and QCI route explanations. SERVER ONLY.
GEMINI_API_KEY="your-gemini-api-key"
# Optional: override the assistant model (default gemini-3.5-flash).
# GEMINI_MODEL="gemini-3.5-flash"
