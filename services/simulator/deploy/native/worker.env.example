# Install to /etc/qrouter/worker.env, owned by root, mode 0640, group qrouter.
# This file holds the shared secret, so it must not be world-readable.

# Must match the web tier's VULTR_SIMULATOR_TOKEN exactly.
SIMULATOR_TOKEN=replace-with-at-least-32-random-bytes

# Set to false only if this host has no NVIDIA GPU. When true, /health returns
# 503 unless Aer can actually reach the GPU, so a silent CPU fallback cannot
# masquerade as a healthy GPU worker.
REQUIRE_GPU=true

WORKERS=2
MAX_QUEUED_JOBS=100
MAX_QUBITS=30
MAX_SHOTS=1000000

# Optional: enable live IBM target compilation and IBM Runtime submission.
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=ibm-q/open/main
IBM_QUANTUM_BACKEND=ibm_brisbane
